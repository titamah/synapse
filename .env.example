# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit it.

# Discord (Developer Portal → your application)
DISCORD_TOKEN=
CLIENT_ID=
SERVER_ID=
# Members with this role (case-insensitive) can use every slash command.
ADMIN_ROLE_NAME=admin

# Postgres (used by Docker Compose to create the database)
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change_me_to_something_long
POSTGRES_DB=synapse

# Only for `npm run dev` outside Docker. Compose builds its own DATABASE_URL.
DATABASE_URL=postgresql://synapse:change_me_to_something_long@localhost:5432/synapse

NODE_ENV=development

# Admin dashboard → Synapse API key (production). Any long random string (32+ chars); the dashboard gets the same value.
ADMIN_API_KEY=
# The dashboard's giveaway page, for "Resolve" buttons in Discord; {id} is the giveaway's ID.
# e.g. https://admin.bostonblerds.com/giveaway/{id}/  (default: http://localhost:3000/giveaways/{id}/)
ADMIN_DASHBOARD_URL=

# Webhooks (production). Leave blank locally.
IG_VERIFY_TOKEN=
IG_APP_SECRET=
# Cloudflare Tunnel (production only): set COMPOSE_PROFILES=tunnel and paste the tunnel token.
# COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
